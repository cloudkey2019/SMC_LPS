{
  "Application": {
    "Name": "LPS.APS.Web",
    "Version": "1.0.0",
    "Environment": "Development",
    "Cors": {
      "AllowedOrigins": [ "http://localhost:3000", "http://localhost:8080" ],
      "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
      "AllowedHeaders": [ "*" ],
      "AllowCredentials": true
    }
  },

  "Database": {
    "APS": {
      "ConnectionString": "Server=10.116.2.75;Database=APS_Production;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer",
      "CommandTimeout": 60,
      "ConnectionTimeout": 15,
      "MaxPoolSize": 100,
      "MinPoolSize": 5,
      "Pooling": true,
      "ReadOnly": false
    },
    "ODS": {
      "ConnectionString": "Server=10.116.2.73;Database=MES_Integration;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer",
      "CommandTimeout": 120,
      "ConnectionTimeout": 15,
      "MaxPoolSize": 50,
      "MinPoolSize": 2,
      "Pooling": true,
      "ReadOnly": false
    },
    "Auth": {
      "ConnectionString": "Server=10.116.2.75;Database=APS_Auth;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer",
      "CommandTimeout": 30,
      "ConnectionTimeout": 15,
      "MaxPoolSize": 50,
      "MinPoolSize": 2,
      "Pooling": true,
      "ReadOnly": false
    },
    "Hangfire": {
      "ConnectionString": "Server=10.116.2.75;Database=APS_Hangfire;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer"
    },
    "EnableRetry": true,
    "MaxRetryCount": 3,
    "RetryDelay": 1000
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "LPS.APS",
    "Database": 3,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "AsyncTimeout": 5000
  },

  "Jwt": {
    "SecretKey": "REPLACE_WITH_YOUR_JWT_SECRET_MIN_32_BYTES",
    "Issuer": "LPS.APS",
    "Audience": "LPS.APS.Web",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },

  "Snapshot": {
    "StoragePath": "D:\\APS_Snapshots"
  },

  "Cache": {
    "DefaultExpiration": "00:30:00",
    "MaxItems": 1000,
    "MaxSize": 104857600,
    "EnableCompression": false,
    "EnableSerialization": true,
    "SerializerType": "SystemTextJson",
    "KeyPrefix": "LPS.APS",
    "EnableStatistics": true,
    "EvictionPolicy": "LRU"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "LPS.APS": "Debug",
      "LPS.APS.Web": "Information",
      "LPS.APS.Engine": "Debug",
      "LPS.APS.Application": "Information",
      "LPS.APS.Core": "Information",
      "LPS.APS.BusinessRules": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "LPS.APS": "Debug",
        "LPS.APS.Engine": "Debug",
        "LPS.APS.Engine.Services.Sync": "Debug",
        "LPS.APS.Application": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Cors": "Warning",
        "Microsoft.WebTools": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/all/aps-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/info/aps-info-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/warn/aps-warn-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} WARN] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error/aps-error-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} ERROR] [{SourceContext}] {Message:lj}{NewLine}{Exception}{NewLine}----------------------------------------{NewLine}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Api": {
    "Version": "v1",
    "Title": "LPS APS API",
    "Description": "Advanced Planning and Scheduling System API",
    "RateLimit": {
      "Enabled": true,
      "Window": "00:01:00",
      "PermitLimit": 100,
      "SlidingWindow": true
    }
  },

  "Business": {
    "Scheduling": {
      "MaxJobsPerSchedule": 1000,
      "DefaultTimeWindow": "08:00:00",
      "OptimizationTimeout": "00:05:00",
      "Parallelism": 4
    },
    "Validation": {
      "EnableStrictValidation": true,
      "MaxJobDuration": "24:00:00",
      "MinOperationDuration": "00:00:01"
    }
  },

  "AllowedHosts": "*"
}
