{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "LPS.APS": "Trace",
      "LPS.APS.Engine.Services.Sync": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Cors": "Warning",
      "Hangfire": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "LPS.APS": "Debug",
        "LPS.APS.Engine": "Debug",
        "LPS.APS.Engine.Services.Sync": "Debug",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Cors": "Warning",
        "Microsoft.WebTools": "Error",
        "Hangfire": "Warning"
      }
    }
  },
  "Api": {
    "RateLimit": {
      "Enabled": false
    }
  }
}
