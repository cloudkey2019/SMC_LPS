          "userId": {
            "type": "integer",
            "description": "用户ID",
            "format": "int32"
          },
          "userCode": {
            "type": "string",
            "description": "用户工号",
            "nullable": true
          },
          "userName": {
            "type": "string",
            "description": "用户姓名",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "角色列表",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "登录响应"
      },
      "LoginResponseDtoApiResponse": {
        "type": "object",
