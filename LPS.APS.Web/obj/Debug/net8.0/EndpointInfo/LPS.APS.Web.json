          },
          "resourceName": {
            "type": "string",
            "nullable": true
          },
          "factoryId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "productionDepartmentId": {
            "type": "integer",
            "format": "int32",
