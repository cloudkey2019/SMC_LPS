          },
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "orderNo": {
            "type": "string",
            "nullable": true
          },
          "materialId": {
            "type": "integer",
            "format": "int32"
          },
          "materialCode": {
            "type": "string",
