# 环境
VITE_NODE_ENV=development

# 接口前缀
VITE_API_BASE_PATH=

# APS 后端 baseURL（Phase D：联通 3号位 RBAC 用）
#  - dev 默认 https://localhost:7044（HTTPS profile，自签证书浏览器会告警可放行）
#  - 用 HTTPS 直连避开 307 跨协议跳转（Node fetch / axios 都拒绝跟 http→https）
VITE_APS_API_BASE_URL=https://localhost:7044

# 打包路径
VITE_BASE_PATH=/

# 标题
VITE_APP_TITLE=APS V1

# 是否全量引入element-plus样式
VITE_USE_ALL_ELEMENT_PLUS_STYLE=true

# 是否开启mock
#  - true  → 项目原 mock（/mock/user/login 等）+ APS MOCK_ROLE_PRESETS
#  - false → 走 3号位真实后端（VITE_APS_API_BASE_URL）
#  ⚠️ 2026-09-18 临时切 true：等 3号位 落地 aps.setup.* 三权限码后改回 false（见催办单 §十）
# VITE_USE_MOCK=false
VITE_USE_MOCK=false

# 是否使用在线图标
VITE_USE_ONLINE_ICON=true

# 是否隐藏全局设置按钮
VITE_HIDE_GLOBAL_SETTING=false
